<script>
  function typewriterRun() {
    const el = document.getElementById('typewriter-text');
    if (!el || el.dataset.typed === 'true') return;
    el.dataset.typed = 'true';
    el.textContent = '';

    const fullText = "Hello!!! — I'm Emilia Macarena Arriaga Rodriguez. Computer Engineering student, ninth semester, National Autonomous University of Mexico. I dismantle real problems and rebuild them as working systems — chasing ethical hacking, secure code, and artificial intelligence. *wink* *wink*";

    let index = 0;
    const speed = 32;
    const pauseChars = { ',': 150, '.': 350, '—': 200 };

    function typeNext() {
      if (index >= fullText.length) return;
      const char = fullText[index];
      el.textContent += char;
      index++;
      const extraPause = pauseChars[char] || 0;
      setTimeout(typeNext, speed + extraPause);
    }

    const target = el.closest('.typewriter-section');
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          setTimeout(typeNext, 400);
          obs.unobserve(entry.target);
        }
      });
    }, { threshold: 0.4 });

    if (target) obs.observe(target);
  }

  function resetTypewriter() {
    const el = document.getElementById('typewriter-text');
    if (el) el.dataset.typed = 'false';
    typewriterRun();
  }

  document.addEventListener('astro:page-load', resetTypewriter);
</script>

<script>
  async function loadSpotify() {
    const tracksEl = document.getElementById('spotify-tracks');
    const artistEl = document.getElementById('spotify-artist');
    if (!tracksEl || !artistEl) return;

    try {
      const res = await fetch('/api/spotify');
      const data = await res.json();

      if (data.tracks && data.tracks.length) {
        tracksEl.innerHTML = data.tracks.map(t => `
          <a href="${t.url}" target="_blank" class="spotify-track">
            <img src="${t.albumArt}" alt="" />
            <div>
              <p class="track-name">${t.name}</p>
              <p class="track-artist">${t.artist}</p>
            </div>
          </a>
        `).join('');
      } else {
        tracksEl.innerHTML = `<p class="font-sans text-sm opacity-50">No recent tracks found.</p>`;
      }

      if (data.topArtist) {
        artistEl.innerHTML = `
          <a href="${data.topArtist.url}" target="_blank" class="artist-link">
            <div class="artist-photo-wrap">
              <img src="${data.topArtist.image}" alt="" />
            </div>
            <p class="artist-name">${data.topArtist.name}</p>
          </a>
        `;
      } else {
        artistEl.innerHTML = `<p class="font-sans text-sm opacity-50">No top artist found.</p>`;
      }

      const moreEl = document.getElementById('spotify-more-artists');
      if (moreEl) {
        if (data.moreArtists && data.moreArtists.length) {
          moreEl.innerHTML = data.moreArtists.map(a => `
            <a href="${a.url}" target="_blank" class="more-artist-link">
              <div class="more-artist-photo-wrap">
                <img src="${a.image}" alt="" />
              </div>
              <p class="more-artist-name">${a.name}</p>
            </a>
          `).join('');
        } else {
          moreEl.innerHTML = '';
        }
      }
    } catch (err) {
      tracksEl.innerHTML = `<p class="font-sans text-sm opacity-50">Couldn't load Spotify data.</p>`;
      artistEl.innerHTML = '';
      const moreEl = document.getElementById('spotify-more-artists');
      if (moreEl) moreEl.innerHTML = '';
    }
  }

  document.addEventListener('astro:page-load', loadSpotify);
</script>

<script>
  function initBrownTransition() {
    const brownLayer = document.getElementById('brown-layer');
    const atmosphere = document.getElementById('spotify-atmosphere');
    const trigger = document.getElementById('spotify-section');
    if (!brownLayer || !trigger) return;

    const obs = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        [brownLayer, atmosphere].forEach((layer) => {
          if (!layer) return;
          if (entry.isIntersecting) {
            layer.classList.remove('opacity-0');
            layer.classList.add('opacity-100');
          } else {
            layer.classList.remove('opacity-100');
            layer.classList.add('opacity-0');
          }
        });
      });
    }, { threshold: 0.25 });

    obs.observe(trigger);
  }

  document.addEventListener('astro:page-load', initBrownTransition);
</script>

<style is:global>
  .animate-fade-in-up {
    opacity: 0;
    transform: translateY(24px);
    animation: fadeInUp 1.2s cubic-bezier(0.2,0.8,0.2,1) forwards;
  }
  .delay-1 { animation-delay: 0.1s; }
  .delay-2 { animation-delay: 0.4s; }
  .delay-4 { animation-delay: 1.6s; }
  @keyframes fadeInUp { to { opacity: 1; transform: translateY(0); } }

  /* ---- Paper background (default) ---- */
  .paper-base {
    background:
      radial-gradient(ellipse 80% 60% at 30% 10%, rgba(255,255,255,0.5), transparent 60%),
      radial-gradient(ellipse 70% 50% at 80% 90%, rgba(180,160,120,0.15), transparent 60%),
      linear-gradient(165deg, #f7f2e4 0%, #efe8d4 40%, #e6ddc4 100%);
  }
  .papergrain {
    opacity: 0.12;
    mix-blend-mode: multiply;
    background-image:
      repeating-linear-gradient(3deg, rgba(0,0,0,0.03) 0px, rgba(0,0,0,0.03) 1px, transparent 1px, transparent 3px),
      radial-gradient(circle at 25% 35%, rgba(0,0,0,0.03), transparent 40%),
      radial-gradient(circle at 75% 65%, rgba(0,0,0,0.025), transparent 45%);
  }

  /* ---- Brown overlay for Spotify section ---- */
  .brown-base {
    background:
      radial-gradient(ellipse 90% 70% at 25% 15%, rgba(90,70,55,0.35), transparent 65%),
      radial-gradient(ellipse 80% 60% at 80% 85%, rgba(40,28,22,0.4), transparent 65%),
      linear-gradient(165deg, #6b5644 0%, #574636 32%, #453626 62%, #362a1e 100%);
  }

  /* ---- Spotify gothic atmosphere: fog, vignette, rays, embers, moth ---- */
  .spotify-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 20%, rgba(20,14,10,0.5) 100%);
    animation: spotifyVignetteBreathe 9s ease-in-out infinite;
  }
  @keyframes spotifyVignetteBreathe {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.72; }
  }

  .spotify-fog {
    position: absolute;
    border-radius: 50%;
    filter: blur(75px);
    opacity: 0.2;
    mix-blend-mode: soft-light;
  }
  .spotify-fog-1 {
    width: 45vw; height: 45vw; top: -12%; left: -12%;
    background: radial-gradient(circle, rgba(210,180,140,0.5), transparent 70%);
    animation: spotifyDriftA 28s ease-in-out infinite;
  }
  .spotify-fog-2 {
    width: 38vw; height: 38vw; bottom: -14%; right: -10%;
    background: radial-gradient(circle, rgba(150,60,60,0.35), transparent 70%);
    animation: spotifyDriftB 33s ease-in-out infinite;
  }
  @keyframes spotifyDriftA {
    0%, 100% { transform: translate(0,0) scale(1); }
    33% { transform: translate(6vw, 4vh) scale(1.1); }
    66% { transform: translate(-3vw, 7vh) scale(0.95); }
  }
  @keyframes spotifyDriftB {
    0%, 100% { transform: translate(0,0) scale(1); }
    33% { transform: translate(-5vw, -6vh) scale(1.08); }
    66% { transform: translate(4vw, -3vh) scale(0.97); }
  }

  .spotify-ray {
    position: absolute;
    top: -20%;
    width: 120px;
    height: 160%;
    background: linear-gradient(180deg, rgba(255,235,200,0.1), transparent 70%);
    transform-origin: top center;
    filter: blur(6px);
  }
  .spotify-ray-1 { left: 18%; transform: rotate(10deg); animation: spotifyRaySway 15s ease-in-out infinite; }
  .spotify-ray-2 { right: 22%; transform: rotate(-8deg); animation: spotifyRaySway 19s ease-in-out infinite reverse; }
  @keyframes spotifyRaySway {
    0%, 100% { opacity: 0.4; transform: rotate(10deg) translateX(0); }
    50% { opacity: 0.7; transform: rotate(7deg) translateX(18px); }
  }

  .spotify-ember {
    position: absolute;
    bottom: -5%;
    width: 3px; height: 3px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(230,210,180,0.85) 0%, rgba(180,150,110,0.25) 70%, transparent 100%);
    filter: blur(0.5px);
    animation-name: spotifyEmberRise;
    animation-timing-function: cubic-bezier(0.4, 0, 0.6, 1);
    animation-iteration-count: infinite;
    opacity: 0;
  }
  @keyframes spotifyEmberRise {
    0%   { transform: translateY(0) translateX(0); opacity: 0; }
    10%  { opacity: 0.6; }
    50%  { transform: translateY(-45vh) translateX(15px); opacity: 0.45; }
    90%  { opacity: 0.12; }
    100% { transform: translateY(-95vh) translateX(-10px); opacity: 0; }
  }

  .spotify-moth {
    position: absolute;
    top: 55%;
    left: 12%;
    opacity: 0;
    animation: spotifyMothFlutter 21s ease-in-out infinite 3s;
  }
  .spotify-moth path { fill: #e6ddc4; opacity: 0.45; }
  @keyframes spotifyMothFlutter {
    0% { opacity: 0; transform: translate(0,0) rotate(0deg); }
    12% { opacity: 0.5; }
    35% { transform: translate(16vw, -10vh) rotate(-14deg); }
    55% { transform: translate(8vw, 8vh) rotate(10deg); }
    75% { transform: translate(20vw, 4vh) rotate(-8deg); opacity: 0.4; }
    92% { opacity: 0; }
    100% { opacity: 0; transform: translate(28vw, -6vh) rotate(0deg); }
  }

  .gothic-cross {
    display: inline-block;
    color: #a4645a;
    opacity: 0.6;
    font-size: 0.9em;
    margin: 0 0.5em;
    transform: translateY(-1px);
  }

  .gothic-flicker {
    animation: gothicFlicker 7s ease-in-out infinite;
  }
  @keyframes gothicFlicker {
    0%, 100% { opacity: 0.94; }
    6%  { opacity: 0.8; }
    11% { opacity: 0.97; }
    38% { opacity: 0.88; }
    47% { opacity: 0.98; }
    68% { opacity: 0.85; }
    82% { opacity: 0.96; }
  }

  .font-heading {
    font-family: 'Playfair Display', serif;
    color: #3a2e22;
    text-shadow: 0 1px 2px rgba(255,255,255,0.4);
  }
  .font-heading-dark {
    font-family: 'Playfair Display', serif;
    color: #f2e9d4;
    text-shadow: 0 0 14px rgba(230,200,150,0.3), 0 1px 3px rgba(0,0,0,0.5);
  }
  .flourish path, .flourish circle { stroke: #a4645a; fill: none; stroke-width: 1; opacity: 0.6; }
  .flourish circle { fill: #a4645a; stroke: none; }
  .flourish-dark path, .flourish-dark circle { stroke: #d9a4a0; fill: none; stroke-width: 1; opacity: 0.6; }
  .flourish-dark circle { fill: #d9a4a0; stroke: none; }

  /* ---- IT girl ---- */
  .itgirl {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 3.2rem;
    opacity: 0;
    transform: translateY(20px) scale(0.9);
    animation: itgirlIn 1.4s cubic-bezier(0.16,1,0.3,1) 0.7s forwards;
  }
  @media (min-width: 768px) {
    .itgirl { font-size: 4.5rem; }
  }
  @keyframes itgirlIn {
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .itgirl-text {
    color: #722F37;
    text-shadow: 0 0 24px rgba(114,47,55,0.25), 0 2px 4px rgba(0,0,0,0.15);
    animation: itgirlGlow 4s ease-in-out 2.1s infinite;
  }
  @keyframes itgirlGlow {
    0%, 100% { text-shadow: 0 0 24px rgba(114,47,55,0.25), 0 2px 4px rgba(0,0,0,0.15); }
    50% { text-shadow: 0 0 38px rgba(114,47,55,0.4), 0 2px 4px rgba(0,0,0,0.15); }
  }
  .itgirl-star {
    display: inline-block;
    color: #a4645a;
    font-size: 0.5em;
    animation: spin 12s linear infinite, starPulse 3s ease-in-out infinite;
  }
  @keyframes starPulse {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }
  @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

  /* ---- Ambient drifting background ---- */
  .drift {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.18;
  }
  .drift-1 {
    width: 40vw; height: 40vw; top: -5%; left: -8%;

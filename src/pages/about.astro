    <span class="spotify-fog spotify-fog-1"></span>
    <span class="spotify-fog spotify-fog-2"></span>
    <div class="spotify-vignette"></div>
    <span class="spotify-ray spotify-ray-1"></span>
    <span class="spotify-ray spotify-ray-2"></span>
    <span class="spotify-ember" style="left:6%; animation-delay:0s; animation-duration:11s;"></span>
    <span class="spotify-ember" style="left:16%; animation-delay:2.4s; animation-duration:9.5s;"></span>
    <span class="spotify-ember" style="left:28%; animation-delay:5s; animation-duration:12s;"></span>
    <span class="spotify-ember" style="left:41%; animation-delay:1.2s; animation-duration:10s;"></span>
    <span class="spotify-ember" style="left:57%; animation-delay:3.6s; animation-duration:11.5s;"></span>
    <span class="spotify-ember" style="left:70%; animation-delay:0.7s; animation-duration:9s;"></span>
    <span class="spotify-ember" style="left:82%; animation-delay:4.4s; animation-duration:10.5s;"></span>
    <span class="spotify-ember" style="left:93%; animation-delay:2s; animation-duration:12.5s;"></span>

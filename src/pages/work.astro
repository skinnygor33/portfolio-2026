<script is:inline>
  function setupBook() {
    const stack = document.getElementById('workbook')?.querySelector('.book-right-stack');
    const prevBtn = document.getElementById('book-prev');
    const nextBtn = document.getElementById('book-next');
    const progress = document.getElementById('book-progress');
    if (!stack || stack.dataset.bookInit) return;
    stack.dataset.bookInit = '1';

    const pages = Array.from(stack.querySelectorAll('.book-page'));
    const total = pages.length;
    let current = 0;

    function render() {
      pages.forEach((p, i) => {
        if (i < current) {
          p.classList.add('flipped');
          p.style.zIndex = i + 1;
        } else {
          p.classList.remove('flipped');
          p.style.zIndex = total - i;
        }
      });
      if (progress) progress.textContent = `Page ${current + 1} of ${total}`;
      if (prevBtn) prevBtn.style.opacity = current === 0 ? '0.25' : '1';
      if (nextBtn) nextBtn.style.opacity = current === total - 1 ? '0.25' : '1';
    }

    nextBtn?.addEventListener('click', () => { if (current < total - 1) { current++; render(); } });
    prevBtn?.addEventListener('click', () => { if (current > 0) { current--; render(); } });

    render();
  }

  function initBackgroundTransitions() {
    const paperLayer = document.getElementById('paper-layer');
    const chapterSection = document.getElementById('chapters-section');
    
    if (!paperLayer || !chapterSection) return;

    const obs = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          paperLayer.classList.remove('opacity-0');
          paperLayer.classList.add('opacity-100');
        } else {
          paperLayer.classList.remove('opacity-100');
          paperLayer.classList.add('opacity-0');
        }
      });
    }, { 
      threshold: 0.15 
    });

    obs.observe(chapterSection);
  }

  function init() {
    setupBook();
    initBackgroundTransitions();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else init();
  document.addEventListener('astro:page-load', init);
</script>


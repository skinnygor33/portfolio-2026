---
import Layout from '../layouts/Layout.astro';

const title = "Experience | Emilia Arriaga";

const chapters = [
  { year: "2022", tag: "Chapter One", title: "Started College", img: "/fisunsetaigen.png",
    body: "Entered the Faculty of Engineering. The moment curiosity turned into formal discipline. Started building the foundation of logic, algorithms, and structural thinking.",
    lesson: "That 'this is boring' doesn't mean skip it — the theory I side-eyed freshman year is the stuff I now reach for the most." },
  { year: "2024", tag: "Chapter Two", title: "Joined Puma Hat Cybersecurity Team", img: "/ut.jpeg",
    body: "Selected for the cybersecurity student group of the Faculty of Engineering. Shifted focus from passive learning to active offense. First exposure to real-world CTF dynamics and collaborative hacking.",
    lesson: "That security is a mindset before it's a toolset. I learned to ask 'how would I break this' before 'does this work.'" },
  { year: "2024", tag: "Chapter Three", title: "Networking events w/ Puma Hat", img: "/phctnw.jpeg",
    body: "Attended various cybersecurity networking events and CTFs in Mexico City and Guadalajara. Connected with industry leaders and expanded my understanding of the Mexican cybersecurity landscape.",
    lesson: "That this industry runs on who you actually talk to, not just what you can do. Showing up mattered more than I expected." },
  { year: "2025", tag: "Chapter Four", title: "Pentesting internship", img: "/pentest.jpeg",
    body: "Executed my first professional Pentesting Service, validating vulnerabilities for the Sports Study Center at UNAM as part of an agreement with Puma Hat.",
    lesson: "That a real client's infrastructure is nothing like a CTF box — you move carefully, document everything, and explain risk in plain language, not just 'critical/high/medium.'" },
  { year: "2025", tag: "Chapter Five", title: "HackMex CTF", img: "/rk.jpeg",
    body: "Competed and classified in the CTF HackMex finale, landing a 7th place (R00tk1t) nationally.",
    lesson: "That placing well is about triaging fast, not knowing everything. Half the battle is knowing when to abandon your first idea." },
  { year: "January 2026", tag: "Chapter Six", title: "Student Mobility Program", img: "/up.jpeg", body: "Accepted into the Pisa university for a winter semester abroad as a part of the student mobility program at my college.",
    lesson: "That being the least experienced person in an unfamiliar system forces better questions than being the most comfortable one." },
  { year: "January 2026", tag: "Chapter Seven", title: "Road to START Mexico City", img: "/start.jpeg", body: "Top 3 finalist in the START Hackathon Mexico City. We built a platform that automates the scientific Climate Action Roadmap, helping mexican small and medium business.",
    lesson: "That a good idea dies fast if you can't explain it in two minutes to someone who isn't technical." },
  { year: "January - May 2026", tag: "Chapter Eight", title: "Internal Audit & Information Security Intern - BMV Group", img: "/mebmv.jpeg", body: "Gained hands-on experience in internal audits and information security practices at the Mexican Stocks Group where I developed various scripts for automating security tasks.",
    lesson: "That automating a manual audit process is mostly understanding why humans did it that way first — the scripting part is the easy 20%." },
  { year: "June - August 2026", tag: "Chapter Nine", title: "Software Development Intern - S&P", img: "/mespglobal.jpeg", body: " Worked on various software development projects, focusing on adding features in existing internal tools and creating full report pipelines for business intelligence.",
    lesson: "That shipping something people at a real company depend on every day hits different than shipping a personal project." },
  { year: "—", tag: "Chapter Ten", title: "", img: "", body: "", blank: true },
];
---

<Layout title={title}>

  <div class="fixed inset-0 -z-30 wood-base"></div>
  <div class="fixed inset-0 -z-30 woodgrain" aria-hidden="true"></div>
  <div id="paper-layer" class="fixed inset-0 -z-29 paper-base opacity-0 transition-opacity duration-[1500ms]"></div>
  <div class="fixed inset-0 pointer-events-none -z-20 bg-[radial-gradient(circle_at_center,_transparent_15%,_rgba(20,14,10,0.45)_100%)] vignette-breathe"></div>

  <div class="fog pointer-events-none fixed inset-0 -z-20 overflow-hidden" aria-hidden="true">
    <span class="fog-blob fog-blob--1"></span>
    <span class="fog-blob fog-blob--2"></span>
    <span class="fog-blob fog-blob--3"></span>
  </div>

  <div class="ambient pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <span class="dust dust-1"></span>
    <span class="dust dust-2"></span>
    <span class="dust dust-3"></span>
    <span class="dust dust-4"></span>
    <span class="dust dust-5"></span>
  </div>

  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <clipPath id="torn-edge" clipPathUnits="objectBoundingBox">
      <polygon points="0.000,0.010 0.125,0.004 0.250,0.020 0.375,0.002 0.500,0.016 0.625,0.006 0.750,0.022 0.875,0.008 0.990,0.000 0.996,0.125 0.980,0.250 0.998,0.375 0.984,0.500 0.994,0.625 0.978,0.750 0.992,0.875 1.000,0.990 0.875,0.996 0.750,0.980 0.625,0.998 0.500,0.984 0.375,0.994 0.250,0.978 0.125,0.992 0.010,1.000 0.004,0.875 0.020,0.750 0.002,0.625 0.016,0.500 0.006,0.375 0.022,0.250 0.008,0.125" />
    </clipPath>
    <clipPath id="torn-edge-photo" clipPathUnits="objectBoundingBox">
      <polygon points="0.000,0.014 0.125,0.006 0.250,0.024 0.375,0.003 0.500,0.020 0.625,0.008 0.750,0.026 0.875,0.010 0.988,0.000 0.995,0.125 0.978,0.250 0.997,0.375 0.982,0.500 0.993,0.625 0.976,0.750 0.990,0.875 1.000,0.986 0.875,0.994 0.750,0.976 0.625,0.997 0.500,0.980 0.375,0.992 0.250,0.974 0.125,0.990 0.012,1.000 0.005,0.875 0.022,0.750 0.003,0.625 0.018,0.500 0.007,0.375 0.024,0.250 0.010,0.125" />
    </clipPath>
  </svg>

  <main class="w-full relative selection:bg-velvet selection:text-paper min-h-screen overflow-x-hidden">

    <section class="pt-32 pb-12 px-6 flex flex-col items-center text-center relative z-10">
        <p class="font-heading text-xs tracking-[0.35em] uppercase opacity-70 mb-4">Experience</p>
        <h1 class="font-heading italic font-bold tracking-wide leading-[0.95]">
          <span class="block text-4xl md:text-6xl">Proof of</span>
          <span class="itgirl block mt-3">
            <span class="itgirl-star">✦</span>
            <span class="itgirl-text">Work</span>
            <span class="itgirl-star">✦</span>
          </span>
        </h1>
        <svg class="flourish mx-auto mt-6" width="90" height="14" viewBox="0 0 90 14" aria-hidden="true">
          <path d="M2,7 Q22,1 45,7 Q68,13 88,7" />
          <circle cx="45" cy="7" r="1.6" />
        </svg>

        <div class="max-w-2xl w-full flex flex-col md:flex-row items-center justify-center gap-8 mt-16 mb-40 animate-fade-in-up relative">
           
            <p class="font-subtitle text-xl md:text-2xl opacity-90 leading-relaxed text-center">
                A look at the skills I've built and the technical tools I rely on to break down hard problems.
            </p>
 
        </div>
    </section>

    <div id="skills-section" class="flex flex-col items-center space-y-24 pb-40 px-6 relative z-10">

      <div class="w-full max-w-3xl relative">
          <div class="text-center mb-10">
              <p class="font-heading text-xs tracking-[0.35em] uppercase opacity-70 mb-2">soft</p>
              <h2 class="font-heading text-4xl md:text-5xl italic font-bold">skills</h2>
          </div>

          <div class="ledger-sheet">
              <div class="ledger-row">
                <span class="ledger-glyph">♔</span>
                <div class="ledger-content">
                  <h3 class="ledger-title">Strategic Logic</h3>
                  <p class="ledger-text">When something breaks I don't stop at the symptom — I keep pulling the thread until I find where it actually went wrong. CTFs taught me that the hard way.</p>
                </div>
              </div>
              <div class="ledger-row">
                <span class="ledger-glyph">♛</span>
                <div class="ledger-content">
                  <h3 class="ledger-title">Leadership</h3>
                  <p class="ledger-text">Somebody has to make the call when a CTF final is falling apart with twenty minutes on the clock. I've gotten comfortable being that person.</p>
                </div>
              </div>
              <div class="ledger-row">
                <span class="ledger-glyph">☍</span>
                <div class="ledger-content">
                  <h3 class="ledger-title">Collaboration</h3>
                  <p class="ledger-text">I've learned to trust teammates who are better than me at the things I'm not, and to speak up the second I notice something they've missed.</p>
                </div>
              </div>
              <div class="ledger-row">
                <span class="ledger-glyph">✦</span>
                <div class="ledger-content">
                  <h3 class="ledger-title">Translation</h3>
                  <p class="ledger-text">I can explain a vulnerability to a security engineer and to my mom, and neither conversation loses the point.</p>
                </div>
              </div>
              <div class="ledger-row">
                <span class="ledger-glyph">∞</span>
                <div class="ledger-content">
                  <h3 class="ledger-title">Resilience</h3>
                  <p class="ledger-text">New tool, new stack, deadline in six hours — I've stopped being precious about doing it "my way" and just learn the thing.</p>
                </div>
              </div>
              <div class="ledger-row">
                <span class="ledger-glyph">👁</span>
                <div class="ledger-content">
                  <h3 class="ledger-title">Observation</h3>
                  <p class="ledger-text">The bug that matters is usually the one nobody flagged. I've gotten weirdly good at noticing what's just slightly off.</p>
                </div>
              </div>
          </div>
      </div>

      <div class="w-full max-w-3xl relative">
          <div class="text-center mb-10">
              <p class="font-heading text-xs tracking-[0.35em] uppercase opacity-70 mb-2">hard</p>
              <h2 class="font-heading text-4xl md:text-5xl italic font-bold">skills</h2>
          </div>

          <div class="ledger-sheet ledger-sheet--tool">
              <div class="ledger-row">
                <span class="ledger-glyph">⚔</span>
                <div class="ledger-content">
                  <h3 class="ledger-title">Penetration Testing</h3>
                  <p class="ledger-text">Kali Linux · Privilege Escalation · Burp Suite · Metasploit · Bash · SQLmap</p>
                </div>
              </div>
              <div class="ledger-row">
                <span class="ledger-glyph">✵</span>
                <div class="ledger-content">
                  <h3 class="ledger-title">Analysis</h3>
                  <p class="ledger-text">Nmap Recon · OSI model · TCP/IP protocols</p>
                </div>
              </div>
              <div class="ledger-row">
                <span class="ledger-glyph">⚒</span>
                <div class="ledger-content">
                  <h3 class="ledger-title">Development</h3>
                  <p class="ledger-text">Python · C · SQL · HTML · CSS · Javascript</p>
                </div>
              </div>
              <div class="ledger-row">
                <span class="ledger-glyph">✎</span>
                <div class="ledger-content">
                  <h3 class="ledger-title">Languages</h3>
                  <p class="ledger-text">Spanish (Native) · English (TOEFL IBT: 92 pts) · Swedish (A1)</p>
                </div>
              </div>
          </div>
      </div>
    </div>

    <!-- ===== THE CHAPTERS: two-page-spread book ===== -->
    <section id="chapters-section" class="relative w-full py-32 px-6 z-20 overflow-x-hidden">
        <div class="max-w-6xl mx-auto relative">

            <div class="text-center mb-20 relative z-10">
                <p class="font-heading chapter-text-dark text-xs tracking-[0.35em] uppercase opacity-70 mb-2">Turn the Pages to Read the Path</p>
                <h2 class="font-heading chapter-text-dark title-glow-dark text-5xl md:text-6xl italic font-bold">Timeline</h2>
                <svg class="flourish flourish-dark mx-auto mt-4" width="90" height="14" viewBox="0 0 90 14" aria-hidden="true">
                  <path d="M2,7 Q22,1 45,7 Q68,13 88,7" />
                  <circle cx="45" cy="7" r="1.6" />
                </svg>
            </div>

            <div class="book-outer">
              <button id="book-prev" class="book-nav" aria-label="Previous page">‹</button>

              <div class="book-cover">
                <div class="book" id="workbook">

                  <div class="book-left-page">
                    <div class="bookplate">
                      <span class="bookplate-ornament">✦</span>
                      <p class="bookplate-title">The Engineer's<br />Ledger</p>
                      <span class="bookplate-rule"></span>
                      <p class="bookplate-sub">Vol. I — Est. 2022</p>
                      <span class="bookplate-ornament">✦</span>
                    </div>
                  </div>

                  <div class="book-right-stack">
                  {chapters.map((c, i) => (
                    <div class="book-page" data-index={i}>
                      <div class="page-front">
                        {c.blank ? (
                          <div class="page-blank">
                            <span class="page-tag">{c.tag}</span>
                            <div class="page-blank-lines">
                              <span></span><span></span><span></span><span></span>
                            </div>
                            <p class="page-blank-note">to be written</p>
                            <span class="page-blank-mark">✎</span>
                          </div>
                        ) : (
                          <>
                            <span class="page-tag">{c.tag}</span>
                            <span class="page-year">{c.year}</span>
                            <div class="page-photo-frame">
                              <div class="page-lesson-note">
                                <span class="page-lesson-mark">✦</span>
                                <p class="page-lesson-label">What I Learned</p>
                                <p class="page-lesson-text">{c.lesson}</p>
                              </div>
                              <div class="page-photo"><img src={c.img} alt="" /></div>
                            </div>
                            <h3 class="page-title">{c.title}</h3>
                            <p class="page-body">{c.body}</p>
                          </>
                        )}
                        <span class="page-number">{i + 1}</span>
                      </div>
                      <div class="page-back">
                        <div class="page-back-inner">
                          <span class="page-back-mark">✦</span>
                          <p class="page-back-quote">iterated, not finished</p>
                        </div>
                      </div>
                    </div>
                  ))}
                  </div>

                </div>
              </div>

              <button id="book-next" class="book-nav" aria-label="Next page">›</button>
            </div>

            <p id="book-progress" class="text-center font-heading chapter-text-dark text-xs tracking-[0.2em] uppercase opacity-70 mt-10">
              Page 1 of {chapters.length}
            </p>

        </div>
    </section>

    <!-- ===== FIELD EXPERIMENTS ===== -->
    <section class="relative w-full py-24 px-6 z-20">
        <div class="max-w-5xl mx-auto">
            <div class="text-center mb-24 relative">
                <p class="font-heading text-xs tracking-[0.35em] uppercase opacity-70 mb-2">Development &amp; Research</p>
                <h2 class="font-heading text-4xl italic font-bold title-glow">Personal Projects</h2>
                <svg class="flourish mx-auto mt-4" width="90" height="14" viewBox="0 0 90 14" aria-hidden="true">
                  <path d="M2,7 Q22,1 45,7 Q68,13 88,7" />
                  <circle cx="45" cy="7" r="1.6" />
                </svg>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="project-card">
                    <span class="skill-tag">Software Development</span>
                    <h3 class="project-title">Emissia</h3>
                    <p class="project-sub">Start Mexico City Hackathon
                    </p>
                    <p class="project-body">Intelligent Roadmap Platform that automates the scientific Climate Action Roadmap, helping Mexican small and medium businesses identify specific changes to turn compliance into profitability.</p>
                    <a href="https://emissia.lat/" target="_blank" class="repo-link">
                      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="8" cy="8" r="6.6"/><path d="M1.4 8h13.2M8 1.4c1.9 1.9 2.9 4.2 2.9 6.6s-1 4.7-2.9 6.6c-1.9-1.9-2.9-4.2-2.9-6.6S6.1 3.3 8 1.4z"/></svg>
                      Visit Website
                    </a>
                </div>

                <div class="project-card">
                    <span class="skill-tag">Software Development</span>
                    <h3 class="project-title">Machine Learning model for fraud detection</h3>
                    <p class="project-sub">Artificial Intelligence</p>
                    <p class="project-body">Cleaned and transformed raw financial transaction data, handling missing values and outliers. Conducted EDA to identify trends in fraudulent behavior.</p>
                    <a href="https://github.com/skinnygor33/VisionAI" target="_blank" class="repo-link">
                      <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                      View Repository
                    </a>
                </div>

                <div class="project-card">
                    <span class="skill-tag">Software Development</span>
                    <h3 class="project-title">Masked Language Model for Plank Exercise Correction</h3>
                    <p class="project-sub">Software Design</p>
                    <p class="project-body">Developed a Masked Language Model (MLM) in Python to guide users in performing plank exercises correctly, utilizing camera-based detection.</p>
                    <a href="https://github.com/skinnygor33/plank-form-mlm" target="_blank" class="repo-link">
                      <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                      View Repository
                    </a>
                </div>

                <div class="project-card">
                    <span class="skill-tag">Hackathon</span>
                    <h3 class="project-title">Savvy</h3>
                    <p class="project-sub">NEXTWAVE Hackathon 2026 — Yuno × Nauta</p>
                    <p class="project-body">Built with a team of four. Savvy watches live payment traffic, tells a genuine conversion drop apart from normal noise, and instead of just firing an alert, gathers the evidence and recommends what to investigate first — then reports it to a dashboard and Slack.</p>
                    <a href="https://github.com/gomiten1/savvy" target="_blank" class="repo-link">
                      <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                      View Repository
                    </a>
                </div>

                <div class="project-card">
                    <span class="skill-tag">Data Structures</span>
                    <h3 class="project-title">Mexico City Transit Graph</h3>
                    <p class="project-sub">Personal Project</p>
                    <p class="project-body">Modeled almost the entire public transportation system of Mexico City — metro, metrobús, and more — as a graph, so a route between any two stations can actually be computed instead of guessed from memory.</p>
                    <a href="https://github.com/skinnygor33/graph-based-public-transportation-for-mexico-city" target="_blank" class="repo-link">
                      <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                      View Repository
                    </a>
                </div>

                <div class="project-card">
                    <span class="skill-tag">Computer Architecture</span>
                    <h3 class="project-title">Z80 Simulator</h3>
                    <p class="project-sub">Structure &amp; Computer Programming Coursework</p>
                    <p class="project-body">Built with two classmates for our computer architecture class — steps through Z80 assembly instruction by instruction and shows what's actually happening in memory and registers as it runs.</p>
                    <a href="https://github.com/4rsenecle/SimuladorZ80/tree/cambios" target="_blank" class="repo-link">
